# Server Configuration
NODE_ENV=development
PORT=5000

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce_bakso_raden
DB_USER=postgres
DB_PASSWORD=postgres

# JWT Configuration
JWT_SECRET=bakso-raden-super-secret-jwt-key-2024
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=bakso-raden-refresh-token-secret-2024
JWT_REFRESH_EXPIRE=30d

# File Upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Session Secret
SESSION_SECRET=bakso-raden-session-secret-2024
